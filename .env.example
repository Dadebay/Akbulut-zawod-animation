# Vite reads these at build time. Copy to .env.local when needed.
# Demo is the default until a read-only SCADA gateway is supplied.
VITE_DATA_MODE=demo
VITE_SCADA_SNAPSHOT_URL=
VITE_FLEET_POSITIONS_URL=

# Optional map tile service. Leave empty for OpenStreetMap.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# VITE_* values are public in the browser bundle. Do not put secrets here.
# The /zawod/ deployment path is set by npm run build:server.
