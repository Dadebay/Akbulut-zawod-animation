{
  "name": "akbulut-production-visualizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:server": "vite build --base=/zawod/ && node scripts/precompress.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:tablet": "node scripts/build-standalone.mjs --tablet",
    "dev:tablet": "node scripts/prepare-tablet.mjs && VITE_RENDER_PROFILE=tablet vite --host 127.0.0.1 --port 5179",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@vitejs/plugin-react": "^5.1.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "vite": "^7.2.2"
  }
}
